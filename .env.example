# PostgreSQL connection string (AWS RDS)
# Format: postgresql://<username>:<password>@<host>:5432/<database>
DATABASE_URL=postgresql://username:password@your-rds-endpoint.amazonaws.com:5432/caveau

# NextAuth.js — required for authentication
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# AWS SES — optional. Required for alert email notifications (feature #19).
# If AWS_SES_FROM_EMAIL is unset, alerts are still created in the DB but no
# email is sent. AWS credentials are resolved via the default AWS SDK chain
# (env vars, shared credentials file, or IAM role).
AWS_REGION=us-east-1
AWS_SES_FROM_EMAIL=alerts@caveau.com
