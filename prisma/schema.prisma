generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ───────────────────────────────────────────────────────────────

enum Role {
  admin
  staff
  member
}

enum Tier {
  gold
  reserve
  platinum
  black
}

enum AlertType {
  temperature
  humidity
  vibration
  light
  door
  access
}

enum Severity {
  info
  warning
  critical
}

enum WineStatus {
  in_cellar
  sold
  transferred
  consumed
  gifted
  removed
}

enum DispositionType {
  sold
  transferred
  consumed
  gifted
  removed
}

enum LockerActivityAction {
  check_in
  check_out
}

// Facility type. Vault facilities are Caveau-operated storage locations;
// private_location facilities are member-owned monitoring locations such as
// residences, restaurants, private clubs, retail rooms, or warehouses.
enum FacilityType {
  vault
  private_location
}

enum PrivateLocationKind {
  residence
  restaurant
  retail
  hospitality
  office
  warehouse
  other
}

enum FacilityEventType {
  weather
  hurricane
  generator_test
  inspection
  incident
}

enum HandoffChannel {
  auction
  broker
  private
}

enum NfcTagTier {
  capsule
  collar
}

enum HurricaneStage {
  watch_issued
  transport_dispatched
  sheltered
  all_clear
  returned
  cancelled
}

enum AlertSource {
  device
  simulation
}

enum DeliveryStatus {
  requested
  pin_entered
  address_confirmed
  otp_verified
  handoff_started
  id_scanned
  completed
  cancelled
  expired
}

enum DeliveryEventActor {
  member
  staff
  system
}

enum DeliveryEventType {
  requested
  biometric_verified
  pin_entered
  pin_failed
  address_confirmed
  otp_sent
  otp_verified
  otp_failed
  handoff_started
  id_scanned
  photo_captured
  completed
  cancelled
  expired
}

enum EventStatus {
  draft
  published
  cancelled
}

enum MigrationSource {
  cellartracker
  vivino
  other
}

enum MigrationStatus {
  submitted
  fulfilled
  failed
  cancelled
}

// Insurance partner program (feature #31). Members submit a referral request
// to apply the Caveau storage-discipline discount with a named carrier.
enum InsuranceReferralStatus {
  submitted
  in_review
  introduced
  bound
  declined
  cancelled
}

// Exit signals (feature #55). `drink_window_closing` triggers when a
// bottle is within its drink window and approaching the end; `peak_momentum`
// when 12-month Liv-ex change crosses a threshold; `dual` when both hit
// and the scoring pass wants to flag the stronger case.
enum ExitSignalReason {
  drink_window_closing
  peak_momentum
  dual
}

enum ExitSignalStrength {
  moderate
  strong
}

// Sentinel fleet (feature #58). `sentinel_locker` is the standard
// locker-mounted environmental sensor; `bottle_probe` is the Estate-tier
// accessory that pairs with a specific bottle (wine_id set, locker_id
// usually null). Same fleet page, same event log — the enum gates the few
// places logic differs (e.g. which link to render in the assignment card).
enum SentinelModel {
  sentinel_locker
  bottle_probe
}

enum SentinelConnectivity {
  wifi
  lte_m
  offline
}

enum SentinelEventType {
  installed
  firmware_updated
  reassigned
  retired
  heartbeat_gap
  battery_low
  connectivity_changed
  test_ping
}

// Exit facilitation (feature #47). Member-initiated consignment. The
// lifecycle is: staff accepts the request, then lists it on the chosen
// channel, then closes the sale. `withdrawn` means staff pulled the
// listing (auction rejected the lot, broker couldn't place, price floor
// not met); `cancelled` means the member backed out before listing.
// Once listed, only staff can terminate via `withdrawn` — the member
// cannot cancel a live auction lot.
enum ExitStatus {
  requested
  listed
  sold
  withdrawn
  cancelled
}

// Sale channel. `self_handled` is the "CCR bundle + you sell it
// privately" option — commission is zero, Caveau never touches the
// funds. The other three are concierge-facilitated: Caveau consigns to
// an auction house, a broker, or a private collector on the member's
// behalf and takes a commission.
enum ExitChannel {
  auction
  broker
  private_sale
  self_handled
}

// Allocations (feature #60). Staff post limited releases → members
// request → staff accept → staff fulfill (writes a Wine row).
enum AllocationStatus {
  draft
  published
  closed
  fulfilled
  cancelled
}

enum AllocationRequestStatus {
  submitted
  accepted
  declined
  cancelled
  fulfilled
}

// Welcome appraisal / valuation document (feature #61). Lifecycle is
// linear: member requests → staff starts drafting → staff completes
// (writes hash + appraisalNumber + line-item snapshot). `cancelled` is a
// terminal branch from submitted/in_progress. Distinct from CCR
// (custody/condition) — this is value-on-paper for insurance, estate, or
// tax purposes.
enum AppraisalStatus {
  submitted
  in_progress
  completed
  cancelled
}

// Appraisal basis — the valuation standard the appraiser is attesting
// to. Insurance underwriters default to fair_market_value;
// retail_replacement is higher and used for total-loss replacement
// policies; auction_estimate is lower and used for liquidation / estate
// planning scenarios where the holder expects to sell through auction.
enum AppraisalBasis {
  fair_market_value
  retail_replacement
  auction_estimate
}

// What the appraisal is for. Drives disclosure language on the
// document (e.g. heirs section is only rendered for `estate`) and the
// recommended basis (insurance → fair_market_value is typical).
enum AppraisalPurpose {
  insurance
  estate
  tax_donation
  divorce
  gift
  personal
}

// Acquisition sourcing workflow (feature #62). Member asks for a
// specific bottle → staff sources from Liv-ex, a broker, an auction, or
// Caveau's private network → staff fulfills (writes a Wine row with
// `sourceAcquisitionId` back-link). Single-stage lifecycle: the
// member-accept step that would normally sit between `sourcing` and
// `fulfilled` is deferred until Stripe (#27) lands and can actually
// block on payment — pre-payment, it would be UX that doesn't do
// anything. `estimated_total_usd` still carries the staff-to-member
// quote communication.
enum AcquisitionStatus {
  requested
  sourcing
  fulfilled
  declined
  cancelled
}

// Where the fulfilled bottle came from. Drives per-source margin
// reporting (admin-only). Null while sourcing is in progress.
enum AcquisitionSource {
  livex
  broker
  auction
  caveau_private
}

model Facility {
  id                         String               @id @default(uuid())
  type                       FacilityType         @default(vault)
  privateLocationKind        PrivateLocationKind? @map("private_location_kind")
  ownerMemberId              String?              @map("owner_member_id")
  name                       String
  location                   String
  elevationFt                Int?                 @map("elevation_ft")
  generatorStatus            String               @default("operational") @map("generator_status")
  fireSuppressionStatus      String               @default("operational") @map("fire_suppression_status")
  lastInspectionAt           DateTime?            @map("last_inspection_at")
  privateLocationCertifiedAt DateTime?            @map("private_location_certified_at")
  locationInstallerId        String?              @map("location_installer_id")
  createdAt                  DateTime             @default(now()) @map("created_at")
  lockers                    Locker[]
  members                    FacilityMember[]
  events                     FacilityEvent[]
  hurricaneProtocols         HurricaneProtocol[]
  tastingEvents              Event[]
  sentinelDevices            SentinelDevice[]
  ownerMember                Member?              @relation("PrivateLocationOwner", fields: [ownerMemberId], references: [id], onDelete: Restrict)
  locationInstaller          LocationInstaller?   @relation(fields: [locationInstallerId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([privateLocationCertifiedAt])
  @@index([locationInstallerId])
  @@index([ownerMemberId, type])
  @@map("facilities")
}

model FacilityEvent {
  id                 String              @id @default(uuid())
  facilityId         String              @map("facility_id")
  type               FacilityEventType
  severity           Severity
  startedAt          DateTime            @map("started_at")
  endedAt            DateTime?           @map("ended_at")
  notes              String?
  createdAt          DateTime            @default(now()) @map("created_at")
  facility           Facility            @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  hurricaneProtocols HurricaneProtocol[]

  @@index([facilityId, startedAt(sort: Desc)])
  @@map("facility_events")
}

model FacilityMember {
  memberId   String   @map("member_id")
  facilityId String   @map("facility_id")
  createdAt  DateTime @default(now()) @map("created_at")
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([memberId, facilityId])
  @@index([facilityId])
  @@map("facility_members")
}

// Certified installation partner network for private locations.
model LocationInstaller {
  id        String    @id @default(uuid())
  name      String
  company   String?
  email     String?
  phone     String?
  region    String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  facilities Facility[]

  @@index([active, createdAt(sort: Desc)])
  @@map("location_installers")
}

model Member {
  id                            String                    @id @default(uuid())
  name                          String
  email                         String                    @unique
  tier                          Tier
  role                          Role                      @default(member)
  passwordHash                  String?                   @map("password_hash")
  emailAlertsEnabled            Boolean                   @default(true) @map("email_alerts_enabled")
  emailAlertSeverity            String                    @default("warning") @map("email_alert_severity")
  emailAlertCooldownMin         Int                       @default(30) @map("email_alert_cooldown_min")
  // SES feedback (#19 follow-up). Set by `/api/ses/webhook` when SNS
  // forwards a bounce or complaint for this member's address. The same
  // route flips `emailAlertsEnabled` to false so we stop hammering a
  // dead/angry inbox; `/settings` reads these to explain why alerts went
  // quiet so the member can correct or appeal.
  emailBounced                  DateTime?                 @map("email_bounced")
  emailComplained               DateTime?                 @map("email_complained")
  onboardedAt                   DateTime?                 @map("onboarded_at")
  // Hurricane Emergency Collection Protection (feature #46). Members opt
  // in via /settings/hurricane; when active, staff see them in the
  // roster for any new HurricaneProtocol activation and a
  // HurricaneProtocolMember row is auto-created on dispatch. The
  // insurance fields record the carrier partnership (#31) that grants
  // premium discounts to enrolled members — surfaced on the settings
  // card for the "why this matters" narrative.
  hurricaneProtectionActive     Boolean                   @default(false) @map("hurricane_protection_active")
  hurricaneProtectionEnrolledAt DateTime?                 @map("hurricane_protection_enrolled_at")
  hurricaneInsurancePartner     String?                   @map("hurricane_insurance_partner")
  hurricaneInsuranceDiscountPct Decimal?                  @map("hurricane_insurance_discount_pct") @db.Decimal(5, 2)
  // Founding Member pricing (feature #54). Set to true + timestamped at
  // completeOnboarding() when the Q3 2027 founding window is still open.
  // The price itself is NOT stored — it's derived from (tier, foundingMember)
  // via src/lib/tiers.ts so a pricing-copy change doesn't require rewriting
  // every row. The flag persists past the window so the "locked for life"
  // promise survives post-launch tier changes.
  foundingMember                Boolean                   @default(false) @map("founding_member")
  foundingLockedAt              DateTime?                 @map("founding_locked_at")
  // Stripe billing (feature #27). These stay nullable so dev/demo runs
  // can ship without Stripe configured; /settings renders a disabled
  // state and server actions return friendly errors when unset.
  stripeCustomerId              String?                   @unique @map("stripe_customer_id")
  stripeSubscriptionId          String?                   @unique @map("stripe_subscription_id")
  stripeSubscriptionStatus      String?                   @map("stripe_subscription_status")
  stripeCurrentPeriodEnd        DateTime?                 @map("stripe_current_period_end")
  // Stripe subscription item ID for the per-slot storage line item so we
  // can update its quantity as lockers are reassigned.
  stripeStorageItemId           String?                   @map("stripe_storage_item_id")
  sessionVersion                Int                       @default(0) @map("session_version")
  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")
  wines                         Wine[]
  lockers                       Locker[]
  dispositions                  WineDisposition[]
  facilities                    FacilityMember[]
  ownedPrivateLocations         Facility[]                 @relation("PrivateLocationOwner")
  handoffPackages               HandoffPackage[]
  hurricaneProtocolMemberships  HurricaneProtocolMember[]
  deliveryRequests              DeliveryRequest[]
  authorizedRecipients          AuthorizedRecipient[]
  eventRsvps                    EventRsvp[]
  migrationRequests             MigrationRequest[]
  insuranceReferrals            InsuranceReferral[]
  exitSignals                   ExitSignal[]
  sentinelDevices               SentinelDevice[]
  sentinelDeviceEvents          SentinelDeviceEvent[] @relation("SentinelDeviceEventActor")
  allocationRequests            AllocationRequest[]
  mobilePushTokens              MobilePushToken[]
  appraisals                    Appraisal[]
  acquisitions                  Acquisition[]
  exitFacilitations             ExitFacilitation[]
  exitFacilitationsClosed       ExitFacilitation[]        @relation("ExitFacilitationSoldBy")
  lockerActivities              LockerActivity[]          @relation("LockerActivityActor")

  @@index([tier])
  @@index([role, createdAt])
  @@map("members")
}

model MobilePushToken {
  id            String   @id @default(uuid())
  memberId      String   @map("member_id")
  expoPushToken String   @unique @map("expo_push_token")
  platform      String?  @map("platform")
  deviceName    String?  @map("device_name")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, active])
  @@map("mobile_push_tokens")
}

model Wine {
  id                   String                  @id @default(uuid())
  name                 String
  vintage              Int
  region               String
  varietal             String
  producer             String
  barcode              String?
  purchasePrice        Decimal                 @map("purchase_price") @db.Decimal(14, 2)
  currentValue         Decimal                 @map("current_value") @db.Decimal(14, 2)
  tastingNotes         String?                 @map("tasting_notes")
  drinkWindowStart     Int?                    @map("drink_window_start")
  drinkWindowEnd       Int?                    @map("drink_window_end")
  status               WineStatus              @default(in_cellar)
  memberId             String                  @map("member_id")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")
  // S3 object key for member-uploaded bottle photo (feature #18). The full
  // public URL is derived at read time via `getPublicUrl(imageKey)` so we
  // can swap CDN domains without rewriting rows.
  imageKey             String?                 @map("image_key")
  // Timestamp of the last successful Liv-ex price sync for this bottle
  // (feature #39). Null for wines that have never been synced — the UI
  // falls back to the most recent WineValuation.date in that case.
  lastValuationSyncAt  DateTime?               @map("last_valuation_sync_at")
  // Back-link to the Allocation this bottle was acquired through
  // (feature #60). Null for wines the member added manually, via
  // migration import (#52), or that pre-date the allocations module.
  // SET NULL on allocation delete so retiring a release doesn't
  // cascade away the member's physical inventory.
  sourceAllocationId   String?                 @map("source_allocation_id")
  // Back-link to the Acquisition this bottle was sourced through
  // (feature #62). Same rules as sourceAllocationId — nullable for
  // manual / migration / legacy / allocation-sourced bottles; SET NULL
  // on acquisition delete so a retired sourcing record doesn't cascade
  // away the member's bottles.
  sourceAcquisitionId  String?                 @map("source_acquisition_id")
  member               Member                  @relation(fields: [memberId], references: [id], onDelete: Restrict)
  lockerSlots          LockerSlot[]
  certificates         ProvenanceCertificate[]
  valuations           WineValuation[]
  dispositions         WineDisposition[]
  handoffPackages      HandoffPackage[]
  nfcTags              NfcTag[]
  deliveryRequestItems DeliveryRequestItem[]
  exitSignals          ExitSignal[]
  sentinelDevices      SentinelDevice[]
  exitFacilitations    ExitFacilitation[]
  lockerActivities     LockerActivity[]
  sourceAllocation     Allocation?             @relation("WineAllocationSource", fields: [sourceAllocationId], references: [id], onDelete: SetNull)
  sourceAcquisition    Acquisition?            @relation("WineAcquisitionSource", fields: [sourceAcquisitionId], references: [id], onDelete: SetNull)

  @@index([barcode])
  @@index([memberId, region, varietal])
  @@index([memberId, status])
  @@index([memberId, status, currentValue(sort: Desc)])
  @@index([sourceAllocationId])
  @@index([sourceAcquisitionId])
  @@map("wines")
}

model WineValuation {
  id     String   @id @default(uuid())
  wineId String   @map("wine_id")
  source String
  price  Decimal  @db.Decimal(14, 2)
  date   DateTime
  wine   Wine     @relation(fields: [wineId], references: [id], onDelete: Cascade)

  @@unique([wineId, date, source])
  @@index([wineId, date(sort: Desc)])
  @@map("wine_valuations")
}

// Liv-ex Fine Wine 100 index history (feature #50 — AI Advisor Q2). Seeded
// monthly so the advisor can compute portfolio-vs-benchmark deltas until a
// live Liv-ex 100 feed is wired. One row per snapshot date; `date` is unique
// so a re-seed or future sync job can upsert on that column.
model LivexBenchmark {
  id         String   @id @default(uuid())
  date       DateTime @unique
  indexValue Decimal  @map("index_value") @db.Decimal(9, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([date(sort: Desc)])
  @@map("livex_benchmark")
}

model Locker {
  id           String                  @id @default(uuid())
  lockerNumber Int                     @map("locker_number")
  zone         String
  facilityId   String                  @map("facility_id")
  memberId     String?                 @map("member_id")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")
  facility     Facility                @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  member       Member?                 @relation(fields: [memberId], references: [id], onDelete: Restrict)
  slots            LockerSlot[]
  readings         SensorReading[]
  hourlyRollups    SensorReadingHourlyRollup[]
  dailyRollups     SensorReadingDailyRollup[]
  alerts           Alert[]
  certificates     ProvenanceCertificate[]
  sentinelDevices  SentinelDevice[]
  activities       LockerActivity[]

  @@unique([facilityId, lockerNumber])
  @@index([memberId])
  @@map("lockers")
}

model LockerSlot {
  id           String    @id @default(uuid())
  lockerId     String    @map("locker_id")
  slotPosition Int       @map("slot_position")
  wineId       String?   @map("wine_id")
  dateStored   DateTime? @map("date_stored")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  locker       Locker    @relation(fields: [lockerId], references: [id], onDelete: Cascade)
  wine         Wine?     @relation(fields: [wineId], references: [id], onDelete: SetNull)

  @@unique([lockerId, slotPosition])
  @@unique([wineId])
  @@map("locker_slots")
}

model LockerActivity {
  id            String               @id @default(uuid())
  action        LockerActivityAction
  lockerId      String               @map("locker_id")
  slotPosition  Int                  @map("slot_position")
  wineId        String               @map("wine_id")
  actorMemberId String               @map("actor_member_id")
  occurredAt    DateTime             @default(now()) @map("occurred_at")
  notes         String?
  createdAt     DateTime             @default(now()) @map("created_at")
  locker        Locker               @relation(fields: [lockerId], references: [id], onDelete: Restrict)
  wine          Wine                 @relation(fields: [wineId], references: [id], onDelete: Restrict)
  actorMember   Member               @relation("LockerActivityActor", fields: [actorMemberId], references: [id], onDelete: Restrict)

  @@index([lockerId, occurredAt(sort: Desc)])
  @@index([wineId, occurredAt(sort: Desc)])
  @@map("locker_activities")
}

model SensorReading {
  id          Int             @default(autoincrement())
  lockerId    String          @map("locker_id")
  // Nullable FK to the device that emitted this reading (feature #58).
  // Ingest resolves `deviceSignature` → device at write time; historical
  // rows stay null, no backfill. Load-bearing once a locker holds both a
  // locker sensor and a bottle probe — without it the two streams conflate.
  deviceId    String?         @map("device_id")
  temperature Decimal         @db.Decimal(5, 2)
  humidity    Decimal         @db.Decimal(5, 2)
  vibration   Decimal         @db.Decimal(5, 3)
  lightLux    Decimal         @map("light_lux") @db.Decimal(7, 2)
  timestamp   DateTime        @default(now())
  locker      Locker          @relation(fields: [lockerId], references: [id], onDelete: Cascade)
  device      SentinelDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@id([id, timestamp])
  @@unique([lockerId, timestamp])
  @@index([lockerId, timestamp(sort: Desc)])
  @@index([deviceId, timestamp(sort: Desc)])
  @@map("sensor_readings")
}

model SensorReadingHourlyRollup {
  lockerId        String   @map("locker_id")
  bucket          DateTime
  temperatureAvg  Decimal  @map("temperature_avg") @db.Decimal(5, 2)
  temperatureMin  Decimal  @map("temperature_min") @db.Decimal(5, 2)
  temperatureMax  Decimal  @map("temperature_max") @db.Decimal(5, 2)
  humidityAvg     Decimal  @map("humidity_avg") @db.Decimal(5, 2)
  humidityMin     Decimal  @map("humidity_min") @db.Decimal(5, 2)
  humidityMax     Decimal  @map("humidity_max") @db.Decimal(5, 2)
  vibrationAvg    Decimal  @map("vibration_avg") @db.Decimal(5, 3)
  vibrationMin    Decimal  @map("vibration_min") @db.Decimal(5, 3)
  vibrationMax    Decimal  @map("vibration_max") @db.Decimal(5, 3)
  lightLuxAvg     Decimal  @map("light_lux_avg") @db.Decimal(7, 2)
  lightLuxMin     Decimal  @map("light_lux_min") @db.Decimal(7, 2)
  lightLuxMax     Decimal  @map("light_lux_max") @db.Decimal(7, 2)
  sampleCount     Int      @map("sample_count")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  locker          Locker   @relation(fields: [lockerId], references: [id], onDelete: Cascade)

  @@id([lockerId, bucket])
  @@index([lockerId, bucket(sort: Desc)])
  @@map("sensor_reading_hourly_rollups")
}

model SensorReadingDailyRollup {
  lockerId        String   @map("locker_id")
  bucket          DateTime
  temperatureAvg  Decimal  @map("temperature_avg") @db.Decimal(5, 2)
  temperatureMin  Decimal  @map("temperature_min") @db.Decimal(5, 2)
  temperatureMax  Decimal  @map("temperature_max") @db.Decimal(5, 2)
  humidityAvg     Decimal  @map("humidity_avg") @db.Decimal(5, 2)
  humidityMin     Decimal  @map("humidity_min") @db.Decimal(5, 2)
  humidityMax     Decimal  @map("humidity_max") @db.Decimal(5, 2)
  vibrationAvg    Decimal  @map("vibration_avg") @db.Decimal(5, 3)
  vibrationMin    Decimal  @map("vibration_min") @db.Decimal(5, 3)
  vibrationMax    Decimal  @map("vibration_max") @db.Decimal(5, 3)
  lightLuxAvg     Decimal  @map("light_lux_avg") @db.Decimal(7, 2)
  lightLuxMin     Decimal  @map("light_lux_min") @db.Decimal(7, 2)
  lightLuxMax     Decimal  @map("light_lux_max") @db.Decimal(7, 2)
  sampleCount     Int      @map("sample_count")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  locker          Locker   @relation(fields: [lockerId], references: [id], onDelete: Cascade)

  @@id([lockerId, bucket])
  @@index([lockerId, bucket(sort: Desc)])
  @@map("sensor_reading_daily_rollups")
}

model SensorRollupState {
  id              Int      @id
  hourlyLastBucket DateTime? @map("hourly_last_bucket")
  dailyLastBucket  DateTime? @map("daily_last_bucket")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("sensor_rollup_state")
}

model Alert {
  id         String      @id @default(uuid())
  lockerId   String      @map("locker_id")
  type       AlertType
  severity   Severity
  // 'device' = persisted by the Sentinel ingest endpoint. 'simulation' =
  // persisted by the /sentinel page's live-simulation action. UI lists
  // and provenance aggregations filter to source='device' by default so
  // simulated alerts can't pollute the audit trail; the /sentinel page
  // has a toggle to surface them.
  source     AlertSource @default(device)
  message    String
  timestamp  DateTime    @default(now())
  resolved   Boolean     @default(false)
  notifiedAt DateTime?   @map("notified_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  locker     Locker      @relation(fields: [lockerId], references: [id], onDelete: Cascade)

  @@index([lockerId, timestamp(sort: Desc)])
  @@index([resolved, lockerId, timestamp(sort: Desc)])
  // [lockerId, type, resolved, notifiedAt] is a strict superset of the
  // older [lockerId, type, notifiedAt] index; Postgres can satisfy both
  // query shapes from the 4-column B-tree without needing the shorter one.
  @@index([lockerId, type, resolved, notifiedAt(sort: Desc)])
  @@map("alerts")
}

model ProvenanceCertificate {
  id                String    @id @default(uuid())
  wineId            String    @map("wine_id")
  lockerId          String    @map("locker_id")
  monitoringStart   DateTime  @map("monitoring_start")
  monitoringEnd     DateTime  @map("monitoring_end")
  tempMean          Decimal?  @map("temp_mean") @db.Decimal(5, 2)
  tempMin           Decimal?  @map("temp_min") @db.Decimal(5, 2)
  tempMax           Decimal?  @map("temp_max") @db.Decimal(5, 2)
  humidityMean      Decimal?  @map("humidity_mean") @db.Decimal(5, 2)
  dataIntegrityHash String    @map("data_integrity_hash")
  certificateNumber String    @unique @map("certificate_number")
  revokedAt         DateTime? @map("revoked_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  wine              Wine      @relation(fields: [wineId], references: [id], onDelete: Cascade)
  locker            Locker    @relation(fields: [lockerId], references: [id], onDelete: Cascade)

  @@index([wineId, lockerId])
  @@index([dataIntegrityHash, revokedAt])
  @@map("provenance_certificates")
}

model WineDisposition {
  id        String          @id @default(uuid())
  wineId    String          @map("wine_id")
  memberId  String          @map("member_id")
  type      DispositionType
  date      DateTime
  salePrice Decimal?        @map("sale_price") @db.Decimal(14, 2)
  recipient String?
  notes     String?
  createdAt DateTime        @default(now()) @map("created_at")
  wine      Wine            @relation(fields: [wineId], references: [id], onDelete: Restrict)
  member    Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([wineId, type, date])
  @@index([wineId])
  @@index([memberId])
  @@map("wine_dispositions")
}

model HandoffPackage {
  id                 String             @id @default(uuid())
  wineId             String             @map("wine_id")
  memberId           String             @map("member_id")
  recipientName      String             @map("recipient_name")
  recipientEmail     String             @map("recipient_email")
  channel            HandoffChannel
  shareToken         String             @unique @map("share_token")
  expiresAt          DateTime?          @map("expires_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  wine               Wine               @relation(fields: [wineId], references: [id], onDelete: Cascade)
  member             Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  accesses           HandoffAccess[]
  exitFacilitations  ExitFacilitation[]

  @@index([memberId, createdAt(sort: Desc)])
  @@index([wineId])
  @@map("handoff_packages")
}

model HandoffAccess {
  id         String         @id @default(uuid())
  packageId  String         @map("package_id")
  ipHash     String         @map("ip_hash")
  userAgent  String?        @map("user_agent")
  accessedAt DateTime       @default(now()) @map("accessed_at")
  package    HandoffPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, accessedAt(sort: Desc)])
  @@map("handoff_accesses")
}

// NFC bottle tracking + tap-to-verify (feature #43). At intake, staff assign
// a tag to a wine: a `capsule` tag for trophy bottles ($1,000+, applied
// invisibly under the foil) or a branded `collar` for standard bottles.
// Both tiers surface the same public `/bottle/[tagId]` landing page when a
// phone taps the chip. `tagId` is the URL path segment — staff scan or enter
// it at intake, and it's used as the primary key so the scan log and
// lookup both work off the same short string without an extra join.
//
// `intakeImageKey` is a separate photo taken at the moment of tagging (bottle
// + tag in-frame) so there's a tamper-evidence record. It's distinct from
// `wine.imageKey`, which is the marketing/reference photo for the member's
// collection view.
//
// `activatedAt` is null between "tag ordered / serial written" and "tag
// applied to a bottle"; once a bottle is assigned the record is considered
// live. We keep the shell row so duplicate-write attempts hit the unique
// constraint rather than silently creating a second record.
model NfcTag {
  id             String     @id @default(uuid())
  tagId          String     @unique @map("tag_id")
  wineId         String     @map("wine_id")
  tier           NfcTagTier
  intakeImageKey String?    @map("intake_image_key")
  issuedAt       DateTime   @default(now()) @map("issued_at")
  activatedAt    DateTime?  @map("activated_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  wine           Wine       @relation(fields: [wineId], references: [id], onDelete: Cascade)
  scans          NfcScan[]

  @@index([wineId])
  @@map("nfc_tags")
}

// One row per phone tap on a tagged bottle. The public /bottle/[tagId] page
// writes here on every successful lookup so Rob can show "this bottle has
// been verified N times" at the member's review. userAgent is truncated to
// 255 chars to bound row size; ipHash is SHA-256(ip + secret) so we can
// distinguish unique viewers without storing raw IPs.
model NfcScan {
  id        String   @id @default(uuid())
  nfcTagId  String   @map("nfc_tag_id")
  ipHash    String   @map("ip_hash")
  userAgent String?  @map("user_agent")
  scannedAt DateTime @default(now()) @map("scanned_at")
  tag       NfcTag   @relation(fields: [nfcTagId], references: [id], onDelete: Cascade)

  @@index([nfcTagId, scannedAt(sort: Desc)])
  @@map("nfc_scans")
}

// Pre-launch founding-member waitlist (feature #49). Public signups land
// here; staff/admins review them from /admin/waitlist. `email` is unique
// so a duplicate submit idempotently returns the existing row rather than
// creating dupes. `source` captures how the lead arrived (e.g. "naples-wine-festival"),
// `loiSigned` tracks whether they've countersigned a letter of intent,
// `referredBy` is free-form so ops can record a member name / code without
// forcing a self-FK at this stage.
model Waitlist {
  id          String    @id @default(uuid())
  name        String
  email       String    @unique
  phone       String?
  source      String?
  notes       String?
  loiSigned   Boolean   @default(false) @map("loi_signed")
  loiSignedAt DateTime? @map("loi_signed_at")
  referredBy  String?   @map("referred_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([loiSigned])
  @@map("waitlist_entries")
}

// Hurricane Emergency Collection Protection activation (feature #46). One
// row per storm: staff kicks off a protocol when the NHC issues a watch for
// the facility's region, refrigerated transport picks up enrolled members'
// collections, and they shelter at an inland airport vault until the
// all-clear. The stage enum walks left-to-right through the protocol so
// the dashboard banner and staff console can render the current state
// without a separate status field.
//
// `facilityEventId` is null until the protocol reaches `all_clear`, at
// which point we create a corresponding FacilityEvent (type: hurricane)
// spanning watchIssuedAt → allClearAt so the existing #42 post-event
// report at /facility/events/[id] picks up seamlessly — members don't
// need a separate "hurricane protocol report" page because #42 already
// tells the right story ("your cellar was safe during Hurricane X").
model HurricaneProtocol {
  id                    String                    @id @default(uuid())
  facilityId            String                    @map("facility_id")
  stormName             String                    @map("storm_name")
  nhcAdvisory           String?                   @map("nhc_advisory")
  category              Int?
  stage                 HurricaneStage            @default(watch_issued)
  watchIssuedAt         DateTime                  @map("watch_issued_at")
  transportDispatchedAt DateTime?                 @map("transport_dispatched_at")
  shelteredAt           DateTime?                 @map("sheltered_at")
  allClearAt            DateTime?                 @map("all_clear_at")
  returnedAt            DateTime?                 @map("returned_at")
  cancelledAt           DateTime?                 @map("cancelled_at")
  facilityEventId       String?                   @unique @map("facility_event_id")
  notes                 String?
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")
  facility              Facility                  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityEvent         FacilityEvent?            @relation(fields: [facilityEventId], references: [id], onDelete: SetNull)
  members               HurricaneProtocolMember[]

  @@index([facilityId, watchIssuedAt(sort: Desc)])
  @@index([stage])
  @@map("hurricane_protocols")
}

// Per-member participation in a single HurricaneProtocol. Snapshot fields
// (`bottleCountSnapshot`, `totalValueSnapshot`) are captured at pickup so
// the post-event narrative can say "43 bottles, $112K protected" even if
// the member's collection changes afterward. Intake/return photo keys are
// S3 object keys for tamper-evidence photos taken by staff at the bottle
// transfer — same pattern as NfcTag.intakeImageKey (#43). We leave them
// nullable so a member who opts out of a specific activation still has a
// row for audit purposes.
model HurricaneProtocolMember {
  id                  String            @id @default(uuid())
  protocolId          String            @map("protocol_id")
  memberId            String            @map("member_id")
  bottleCountSnapshot Int?              @map("bottle_count_snapshot")
  totalValueSnapshot  Decimal?          @map("total_value_snapshot") @db.Decimal(14, 2)
  intakePhotoKey      String?           @map("intake_photo_key")
  returnPhotoKey      String?           @map("return_photo_key")
  notes               String?
  createdAt           DateTime          @default(now()) @map("created_at")
  protocol            HurricaneProtocol @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  member              Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([protocolId, memberId])
  @@index([memberId, createdAt(sort: Desc)])
  @@map("hurricane_protocol_members")
}

// Biometric-verified "Deliver Now" request (feature #51). Captures the full
// 4-step member ladder (biometric tap → PIN → address confirm → step-up
// OTP when total value ≥ $2K) plus the door-side handoff log. PIN and OTP
// are hashed with SHA-256 + a per-request 16-byte salt (see
// src/lib/delivery.ts); rate-limiting caps attempts at 5/15min so the
// fast-hash choice is safe versus bcrypt's ~100ms cost.
model DeliveryRequest {
  id                  String         @id @default(uuid())
  memberId            String         @map("member_id")
  status              DeliveryStatus @default(requested)
  isBiometricVerified Boolean        @default(false) @map("is_biometric_verified")

  // PIN is set on creation. OTP is set only when total currentValue of the
  // items crosses OTP_THRESHOLD_USD ($2K) — see isOtpRequired().
  pinSalt     String  @map("pin_salt")
  pinHash     String  @map("pin_hash")
  otpRequired Boolean @default(false) @map("otp_required")
  otpSalt     String? @map("otp_salt")
  otpHash     String? @map("otp_hash")

  pinAttempts   Int       @default(0) @map("pin_attempts")
  otpAttempts   Int       @default(0) @map("otp_attempts")
  pinVerifiedAt DateTime? @map("pin_verified_at")
  otpVerifiedAt DateTime? @map("otp_verified_at")

  // Address snapshot captured at delivery time. Keeping scalar columns
  // here (instead of a MemberAddress model) gives us an audit-trail
  // guarantee the recipient address can't drift after the fact.
  deliveryAddressLine1 String  @map("delivery_address_line1")
  deliveryAddressLine2 String? @map("delivery_address_line2")
  deliveryCity         String  @map("delivery_city")
  deliveryState        String  @map("delivery_state")
  deliveryPostalCode   String  @map("delivery_postal_code")

  // Door-side handoff log. Photo key is the S3 object key for the staff
  // handoff photo (same convention as NfcTag.intakeImageKey).
  scannedRecipientName String? @map("scanned_recipient_name")
  handoffPhotoKey      String? @map("handoff_photo_key")

  // Unguessable token that keys the public driver URL at
  // /handoff-driver/[token]. Null until the member-side ladder finishes
  // (address_confirmed when !otpRequired, otp_verified when otpRequired).
  driverToken String? @unique @map("driver_token")

  expiresAt   DateTime  @map("expires_at")
  completedAt DateTime? @map("completed_at")
  cancelledAt DateTime? @map("cancelled_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  member Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  items  DeliveryRequestItem[]
  events DeliveryEvent[]

  @@index([memberId, createdAt(sort: Desc)])
  @@index([status])
  @@index([expiresAt])
  @@map("delivery_requests")
}

model DeliveryRequestItem {
  id                String   @id @default(uuid())
  deliveryRequestId String   @map("delivery_request_id")
  wineId            String   @map("wine_id")
  createdAt         DateTime @default(now()) @map("created_at")

  deliveryRequest DeliveryRequest @relation(fields: [deliveryRequestId], references: [id], onDelete: Cascade)
  // Restrict — preserve the audit trail of what was delivered if a wine
  // row is ever removed. Matches WineDisposition's guarantee.
  wine            Wine            @relation(fields: [wineId], references: [id], onDelete: Restrict)

  @@unique([deliveryRequestId, wineId])
  @@index([wineId])
  @@map("delivery_request_items")
}

model DeliveryEvent {
  id                String             @id @default(uuid())
  deliveryRequestId String             @map("delivery_request_id")
  actor             DeliveryEventActor
  type              DeliveryEventType
  payload           Json?
  createdAt         DateTime           @default(now()) @map("created_at")

  deliveryRequest DeliveryRequest @relation(fields: [deliveryRequestId], references: [id], onDelete: Cascade)

  @@index([deliveryRequestId, createdAt(sort: Desc)])
  @@index([actor, createdAt(sort: Desc)])
  @@map("delivery_events")
}

// Per-member registry of people allowed to receive a delivery at the door.
// The staff handoff ladder matches a scanned-ID name against this list
// (case-insensitive substring match for demo — real ID-parsing services
// like Jumio/Onfido slot in post-demo without model changes).
model AuthorizedRecipient {
  id           String   @id @default(uuid())
  memberId     String   @map("member_id")
  name         String
  relationship String?
  // Required for the Florida DABT age floor (>= 21) enforced at handoff
  // in /api/deliveries/by-token/[token]/id-scan. DATE (no time) so ISO
  // string compares against driver-entered DOB are unambiguous across
  // server/client TZ boundaries.
  dateOfBirth  DateTime @map("date_of_birth") @db.Date
  createdAt    DateTime @default(now()) @map("created_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, name])
  @@index([memberId])
  @@map("authorized_recipients")
}

// Events & tasting module (feature #53). `Event` is intentionally distinct
// from the `FacilityEvent` model (which is bounded to resilience incidents
// like hurricanes and inspections, #42). Pricing is captured for display
// only until the payments feature (#27) lands; RSVP is treated as confirmed
// without a charge. memberOnly events are hidden from the public `/events`
// list for unauthenticated visitors.
model Event {
  id           String        @id @default(uuid())
  facilityId   String?       @map("facility_id")
  slug         String        @unique
  title        String
  summary      String?
  description  String?
  locationName String        @map("location_name")
  locationAddr String?       @map("location_addr")
  startsAt     DateTime      @map("starts_at")
  endsAt       DateTime      @map("ends_at")
  capacity     Int
  priceUsd     Decimal       @default(0) @map("price_usd") @db.Decimal(10, 2)
  memberOnly   Boolean       @default(false) @map("member_only")
  status       EventStatus   @default(published)
  heroImageKey String?       @map("hero_image_key")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  facility     Facility?     @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  rsvps        EventRsvp[]
  signups      EventSignup[]

  @@index([startsAt])
  @@index([status, startsAt])
  @@map("events")
}

// Authenticated-member RSVPs. One row per (event, member); `seats` covers
// the +1 case without a second model (cap enforced at 4 in the Zod schema
// so no one RSVPs the entire capacity on one click). `cancelledAt` is
// nullable so backing out preserves the audit row — the roster filters it
// out, but admins can still see who changed their mind.
model EventRsvp {
  id          String    @id @default(uuid())
  eventId     String    @map("event_id")
  memberId    String    @map("member_id")
  seats       Int       @default(1)
  notes       String?
  cancelledAt DateTime? @map("cancelled_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
  @@index([memberId, createdAt(sort: Desc)])
  @@map("event_rsvps")
}

// Non-member public signups (lead capture). Kept separate from EventRsvp
// so "member roster" vs "leads to follow up with" is unambiguous. Unique
// on (eventId, email) so an accidental double-submit is idempotent.
model EventSignup {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  name      String
  email     String
  phone     String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@index([eventId, createdAt(sort: Desc)])
  @@map("event_signups")
}

// Concierge migration request (feature #52). Members upload a CellarTracker
// or Vivino CSV export; staff fulfill within 48 hours by creating Wine rows
// from the mapped payload. `rows` and `columnMapping` are stored as JSON
// instead of a child table because typical exports are <500 rows and staff
// edits the mapping (not per-row data) before fulfillment — a
// MigrationRow model would double the write cost with no payoff at demo
// scale. `onDelete: Cascade` matches intake-artifact semantics (unlike
// Wine/Locker Restrict); fulfilled Wine rows have their own protection.
model MigrationRequest {
  id                 String          @id @default(uuid())
  memberId           String          @map("member_id")
  source             MigrationSource
  originalFilename   String          @map("original_filename")
  status             MigrationStatus @default(submitted)
  columnMapping      Json            @map("column_mapping")
  rows               Json
  rowCount           Int             @map("row_count")
  note               String?
  failureReason      String?         @map("failure_reason")
  fulfilledWineCount Int?            @map("fulfilled_wine_count")
  fulfilledAt        DateTime?       @map("fulfilled_at")
  fulfilledById      String?         @map("fulfilled_by_id")
  cancelledAt        DateTime?       @map("cancelled_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  member             Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("migration_requests")
}

// Insurance partner referral request (feature #31). Member asks Caveau to
// introduce them to a partner carrier and share proof-of-storage + CCR
// exports. `shareToken` is the partner-safe reference the member provides
// their carrier — partner APIs scope all reads to the token.
model InsuranceReferral {
  id           String                 @id @default(uuid())
  memberId     String                 @map("member_id")
  partnerName  String                 @map("partner_name")
  status       InsuranceReferralStatus @default(submitted)
  shareToken   String                 @unique @default(uuid()) @map("share_token")
  contactName  String?                @map("contact_name")
  contactEmail String?                @map("contact_email")
  contactPhone String?                @map("contact_phone")
  policyNumber String?                @map("policy_number")
  memberNote   String?                @map("member_note")
  staffNote    String?                @map("staff_note")
  introducedAt DateTime?              @map("introduced_at")
  boundAt      DateTime?              @map("bound_at")
  declinedAt   DateTime?              @map("declined_at")
  cancelledAt  DateTime?              @map("cancelled_at")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  member       Member                 @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("insurance_referrals")
}

// Exit signals (feature #55). AI-surfaced sell-window alerts per bottle,
// tied to drink-window timing plus 12-month price momentum. Visible on
// the dashboard, the wine detail page, and the AI Advisor. "Open" =
// `closedAt` is null; the scoring pass in `src/lib/exit-signals.ts` keeps
// at most one open row per wine and a partial unique index in migration
// 0034 enforces that invariant at the DB level. `targetPriceLow` and
// `targetPriceHigh` frame the recommended ask in USD; `rationale` is the
// one-sentence "why now" the member sees on the dashboard card and the
// advisor surfaces verbatim.
model ExitSignal {
  id                 String             @id @default(uuid())
  wineId             String             @map("wine_id")
  memberId           String             @map("member_id")
  reason             ExitSignalReason
  strength           ExitSignalStrength
  rationale          String
  priceSnapshot      Decimal            @map("price_snapshot") @db.Decimal(14, 2)
  targetPriceLow     Decimal            @map("target_price_low") @db.Decimal(14, 2)
  targetPriceHigh    Decimal            @map("target_price_high") @db.Decimal(14, 2)
  momentum12moPct    Decimal?           @map("momentum_12mo_pct") @db.Decimal(6, 2)
  openedAt           DateTime           @default(now()) @map("opened_at")
  closedAt           DateTime?          @map("closed_at")
  closedReason       String?            @map("closed_reason")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  wine               Wine               @relation(fields: [wineId], references: [id], onDelete: Cascade)
  member             Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, closedAt, openedAt(sort: Desc)])
  @@index([wineId, closedAt])
  @@map("exit_signals")
}

// Sentinel device registry (feature #58). One row per physical unit — both
// Caveau Naples locker sensors and Estate-tier Bottle Probes. Static
// inventory (serial, model, firmware) and mutable heartbeat state
// (battery, connectivity, lastHeartbeatAt) live on the same row; a 1:1
// status table was considered and rejected because heartbeats are read on
// every admin page load. `bundledWithTier` is null when purchased
// outright, otherwise records which tier entitled the unit — carries more
// info than a boolean when a member downgrades tiers later. `lockerId` is
// set for sensors; `wineId` is set for probes. Ingest resolves
// `deviceSignature` → device and updates mutable state on each reading.
model SentinelDevice {
  id                  String                @id @default(uuid())
  serialNumber        String                @unique @map("serial_number")
  model               SentinelModel
  hardwareRev         String?               @map("hardware_rev")
  firmwareVersion     String                @map("firmware_version")
  facilityId          String                @map("facility_id")
  lockerId            String?               @map("locker_id")
  memberId            String?               @map("member_id")
  wineId              String?               @map("wine_id")
  bundledWithTier     Tier?                 @map("bundled_with_tier")
  purchasedAt         DateTime?             @map("purchased_at")
  installedAt         DateTime?             @map("installed_at")
  retiredAt           DateTime?             @map("retired_at")
  connectivity        SentinelConnectivity  @default(offline)
  batteryPct          Int?                  @map("battery_pct")
  lastHeartbeatAt     DateTime?             @map("last_heartbeat_at")
  alertRoutingConfig  Json?                 @map("alert_routing_config")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  facility            Facility              @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  locker              Locker?               @relation(fields: [lockerId], references: [id], onDelete: SetNull)
  member              Member?               @relation(fields: [memberId], references: [id], onDelete: SetNull)
  wine                Wine?                 @relation(fields: [wineId], references: [id], onDelete: SetNull)
  events              SentinelDeviceEvent[]
  readings            SensorReading[]

  @@index([facilityId, lastHeartbeatAt(sort: Desc)])
  @@index([memberId])
  @@index([lockerId])
  @@map("sentinel_devices")
}

// Per-device audit log (feature #58). `actorMemberId` is the staff user
// who performed a manual action; system-emitted events (heartbeat_gap,
// battery_low, connectivity_changed) leave it null. `payload` is opaque
// JSON — e.g. { from: "2.3.5", to: "2.4.1" } for firmware bumps.
model SentinelDeviceEvent {
  id             String             @id @default(uuid())
  deviceId       String             @map("device_id")
  type           SentinelEventType
  actorMemberId  String?            @map("actor_member_id")
  payload        Json?
  createdAt      DateTime           @default(now()) @map("created_at")
  device         SentinelDevice     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  actor          Member?            @relation("SentinelDeviceEventActor", fields: [actorMemberId], references: [id], onDelete: SetNull)

  @@index([deviceId, createdAt(sort: Desc)])
  @@map("sentinel_device_events")
}

// Private allocations / limited releases (feature #60). Staff posts a
// release with per-tier eligibility; eligible members can request bottles;
// staff accepts winners and fulfills (writes Wine rows with
// sourceAllocationId set). Two-stage fulfillment (accepted → fulfilled)
// leaves room for off-line payment between the two until Stripe (#27)
// lands. foundingOnly AND-s a founding-member gate on top of
// minimumTier; foundingEarlyAccess gives founding members visibility
// before opensAt.
model Allocation {
  id                   String                  @id @default(uuid())
  slug                 String                  @unique
  producer             String
  wineName             String                  @map("wine_name")
  vintage              Int
  region               String
  varietal             String
  description          String?
  tastingNotes         String?                 @map("tasting_notes")
  quantity             Int
  pricePerBottleUsd    Decimal                 @map("price_per_bottle_usd") @db.Decimal(14, 2)
  minimumTier          Tier                    @map("minimum_tier")
  foundingOnly         Boolean                 @default(false) @map("founding_only")
  foundingEarlyAccess  Boolean                 @default(false) @map("founding_early_access")
  status               AllocationStatus        @default(draft)
  heroImageKey         String?                 @map("hero_image_key")
  opensAt              DateTime                @map("opens_at")
  closesAt             DateTime                @map("closes_at")
  publishedAt          DateTime?               @map("published_at")
  closedAt             DateTime?               @map("closed_at")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")
  requests             AllocationRequest[]
  sourcedWines         Wine[]                  @relation("WineAllocationSource")

  @@index([status, opensAt])
  @@index([minimumTier, status])
  @@map("allocations")
}

// Welcome appraisal / valuation document (feature #61). Distinct from
// the Caveau Custody & Condition Report — a CCR attests to
// custody/environmental conditions; an Appraisal attests to dollar
// value at a point in time for insurance, estate, tax-donation, or
// personal purposes. Request fields (`purpose`, `basis`, `memberNote`,
// `scopedWineIds`, `heirs`) are member-authored on submit; authoring
// fields (`appraiserName`, `appraiserCreds`, `scopeOfWork`,
// `effectiveDate`, `totalBasisUsd`, `bottleCount`, `lineItems`,
// `appraisalNumber`, `dataIntegrityHash`) are staff-authored on
// completion. `lineItems` is a JSON snapshot of the bottles the
// appraiser valued — captured at completion so the document stays
// stable even if the member's portfolio changes afterward. `heirs` is
// nullable and only populated for `purpose = estate`.
// `isWelcomeAppraisal` marks the founding-member freebie so eligibility
// checks can run without a dedicated Member column (see
// src/lib/appraisals.ts). Price is stored on the row (not derived) so
// the historical record reflects what the member was actually charged
// even if the tier pricing ladder changes later.
model Appraisal {
  id                 String            @id @default(uuid())
  memberId           String            @map("member_id")
  status             AppraisalStatus   @default(submitted)
  purpose            AppraisalPurpose
  basis              AppraisalBasis
  memberNote         String?           @map("member_note")
  scopedWineIds      Json?             @map("scoped_wine_ids")
  heirs              Json?
  appraiserName      String?           @map("appraiser_name")
  appraiserCreds     String?           @map("appraiser_creds")
  scopeOfWork        String?           @map("scope_of_work")
  staffNote          String?           @map("staff_note")
  effectiveDate      DateTime?         @map("effective_date")
  totalBasisUsd      Decimal?          @map("total_basis_usd") @db.Decimal(14, 2)
  bottleCount        Int?              @map("bottle_count")
  lineItems          Json?             @map("line_items")
  priceChargedUsd    Decimal?          @map("price_charged_usd") @db.Decimal(14, 2)
  isWelcomeAppraisal Boolean           @default(false) @map("is_welcome_appraisal")
  appraisalNumber    String?           @unique @map("appraisal_number")
  dataIntegrityHash  String?           @map("data_integrity_hash")
  revokedAt          DateTime?         @map("revoked_at")
  completedAt        DateTime?         @map("completed_at")
  cancelledAt        DateTime?         @map("cancelled_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  member             Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([dataIntegrityHash])
  @@map("appraisals")
}

// Per-member interest in an allocation. Unique on (allocationId, memberId)
// so a cancelled row is preserved (for audit) and the member can't
// double-submit. Lifecycle: submitted → accepted → fulfilled, with
// declined / cancelled branches. `fulfilledById` is the staff member
// who wrote the resulting Wine row.
model AllocationRequest {
  id                 String                   @id @default(uuid())
  allocationId       String                   @map("allocation_id")
  memberId           String                   @map("member_id")
  quantityRequested  Int                      @map("quantity_requested")
  memberNote         String?                  @map("member_note")
  status             AllocationRequestStatus  @default(submitted)
  staffNote          String?                  @map("staff_note")
  acceptedAt         DateTime?                @map("accepted_at")
  declinedAt         DateTime?                @map("declined_at")
  cancelledAt        DateTime?                @map("cancelled_at")
  fulfilledAt        DateTime?                @map("fulfilled_at")
  fulfilledById      String?                  @map("fulfilled_by_id")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  allocation         Allocation               @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  member             Member                   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([allocationId, memberId])
  @@index([memberId, createdAt(sort: Desc)])
  @@index([status, allocationId])
  @@map("allocation_requests")
}

// Acquisition sourcing request (feature #62). Reverse of Allocation:
// member asks for a specific bottle, staff sources it. Single-stage
// lifecycle: requested → sourcing → fulfilled (+ declined / cancelled
// branches). Fulfillment writes `quantity` Wine rows with
// `sourceAcquisitionId` set so the bottle carries provenance back to
// the request. Pricing fields split between staff-facing (cost,
// margin) and member-facing (estimated_total, member_price). Margin is
// admin-only reporting — slide 15's "8–12% margin tracked" is the
// operator's handle, not member-facing.
model Acquisition {
  id                 String              @id @default(uuid())
  memberId           String              @map("member_id")
  // Request spec — producer is required; everything else is optional so
  // a member can say "any vintage of X between 2015–2018" or "any
  // Northern Rhône under $2K" in combination with `memberNote`.
  producer           String
  wineName           String?             @map("wine_name")
  vintageExact       Int?                @map("vintage_exact")
  vintageMin         Int?                @map("vintage_min")
  vintageMax         Int?                @map("vintage_max")
  region             String?
  varietal           String?
  quantity           Int
  maxBudgetUsd       Decimal?            @map("max_budget_usd") @db.Decimal(14, 2)
  memberNote         String?             @map("member_note")
  // Sourcing state (staff-authored)
  status             AcquisitionStatus   @default(requested)
  staffNote          String?             @map("staff_note")
  source             AcquisitionSource?
  estimatedTotalUsd  Decimal?            @map("estimated_total_usd") @db.Decimal(14, 2)
  actualCostUsd      Decimal?            @map("actual_cost_usd") @db.Decimal(14, 2)
  memberPriceUsd     Decimal?            @map("member_price_usd") @db.Decimal(14, 2)
  marginUsd          Decimal?            @map("margin_usd") @db.Decimal(14, 2)
  // Lifecycle timestamps
  sourcingStartedAt  DateTime?           @map("sourcing_started_at")
  fulfilledAt        DateTime?           @map("fulfilled_at")
  declinedAt         DateTime?           @map("declined_at")
  cancelledAt        DateTime?           @map("cancelled_at")
  fulfilledById      String?             @map("fulfilled_by_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  member             Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sourcedWines       Wine[]              @relation("WineAcquisitionSource")

  @@index([memberId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("acquisitions")
}

// Exit facilitation (feature #47). Member-initiated consignment workflow
// mirroring the acquisition shape (#62) in reverse: member requests → staff
// accepts + lists → staff closes the sale or withdraws. Pairs with exit
// signals (#55) — an open ExitSignal on a wine is usually the proximate
// reason a member initiates an exit facilitation for that wine, and the
// signal auto-closes when the facilitation flips to `sold`.
//
// Commission fields are admin-only reporting (same contract as
// Acquisition.marginUsd): the operator-facing CSV + admin queue expose
// them; member surfaces and the AI Advisor's getMyExits tool never do.
// `self_handled` channels carry zero commission — Caveau supplies the
// CCR bundle but doesn't touch the funds.
//
// At most one non-terminal row per wine (enforced by a partial unique
// index in migration 0039) prevents double-listing the same bottle.
// `handoffPackageId` is an optional attachment — staff generate a #41
// shareable bundle when an auction house or broker wants to view the
// CCR + Liv-ex snapshot + provenance timeline inline.
model ExitFacilitation {
  id                 String           @id @default(uuid())
  wineId             String           @map("wine_id")
  memberId           String           @map("member_id")
  // Member-authored request fields
  memberNote         String?          @map("member_note")
  targetPriceLow     Decimal?         @map("target_price_low") @db.Decimal(14, 2)
  targetPriceHigh    Decimal?         @map("target_price_high") @db.Decimal(14, 2)
  preferredChannel   ExitChannel?     @map("preferred_channel")
  // Staff-authored lifecycle state
  status             ExitStatus       @default(requested)
  channel            ExitChannel?
  auctionHouseName   String?          @map("auction_house_name")
  staffNote          String?          @map("staff_note")
  listedPriceUsd     Decimal?         @map("listed_price_usd") @db.Decimal(14, 2)
  // Settlement — gross/net member-visible; commission fields admin-only.
  // net = gross - commission (denormalized for single-query admin CSV).
  grossProceedsUsd   Decimal?         @map("gross_proceeds_usd") @db.Decimal(14, 2)
  commissionPct      Decimal?         @map("commission_pct") @db.Decimal(5, 2)
  commissionUsd      Decimal?         @map("commission_usd") @db.Decimal(14, 2)
  netProceedsUsd     Decimal?         @map("net_proceeds_usd") @db.Decimal(14, 2)
  // Lifecycle timestamps
  listedAt           DateTime?        @map("listed_at")
  soldAt             DateTime?        @map("sold_at")
  withdrawnAt        DateTime?        @map("withdrawn_at")
  withdrawnReason    String?          @map("withdrawn_reason")
  cancelledAt        DateTime?        @map("cancelled_at")
  soldById           String?          @map("sold_by_id")
  handoffPackageId   String?          @map("handoff_package_id")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  wine               Wine             @relation(fields: [wineId], references: [id], onDelete: Restrict)
  member             Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  soldBy             Member?          @relation("ExitFacilitationSoldBy", fields: [soldById], references: [id], onDelete: SetNull)
  handoffPackage     HandoffPackage?  @relation(fields: [handoffPackageId], references: [id], onDelete: SetNull)

  @@index([memberId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([wineId])
  @@map("exit_facilitations")
}
