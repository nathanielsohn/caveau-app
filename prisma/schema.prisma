generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ───────────────────────────────────────────────────────────────

enum Role {
  admin
  staff
  member
}

enum Tier {
  gold
  platinum
  black
}

enum AlertType {
  temperature
  humidity
  vibration
  light
  door
  access
}

enum Severity {
  info
  warning
  critical
}

enum WineStatus {
  in_cellar
  sold
  transferred
  consumed
  gifted
  removed
}

enum DispositionType {
  sold
  transferred
  consumed
  gifted
  removed
}

model Facility {
  id        String   @id @default(uuid())
  name      String
  location  String
  createdAt DateTime @default(now()) @map("created_at")
  lockers   Locker[]
  members   FacilityMember[]

  @@map("facilities")
}

model FacilityMember {
  memberId   String   @map("member_id")
  facilityId String   @map("facility_id")
  createdAt  DateTime @default(now()) @map("created_at")
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([memberId, facilityId])
  @@index([facilityId])
  @@map("facility_members")
}

model Member {
  id                    String   @id @default(uuid())
  name                  String
  email                 String   @unique
  tier                  Tier
  role                  Role     @default(member)
  passwordHash          String?  @map("password_hash")
  emailAlertsEnabled    Boolean  @default(true) @map("email_alerts_enabled")
  emailAlertSeverity    String   @default("warning") @map("email_alert_severity")
  emailAlertCooldownMin Int       @default(30) @map("email_alert_cooldown_min")
  onboardedAt           DateTime? @map("onboarded_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  wines                 Wine[]
  lockers               Locker[]
  dispositions          WineDisposition[]
  facilities            FacilityMember[]

  @@index([tier])
  @@index([role])
  @@map("members")
}

model Wine {
  id               String                @id @default(uuid())
  name             String
  vintage          Int
  region           String
  varietal         String
  producer         String
  purchasePrice    Decimal               @map("purchase_price") @db.Decimal(14, 2)
  currentValue     Decimal               @map("current_value") @db.Decimal(14, 2)
  tastingNotes     String?               @map("tasting_notes")
  drinkWindowStart Int?                  @map("drink_window_start")
  drinkWindowEnd   Int?                  @map("drink_window_end")
  status           WineStatus            @default(in_cellar)
  memberId         String                @map("member_id")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  // S3 object key for member-uploaded bottle photo (feature #18). The full
  // public URL is derived at read time via `getPublicUrl(imageKey)` so we
  // can swap CDN domains without rewriting rows.
  imageKey         String?               @map("image_key")
  // Timestamp of the last successful Liv-ex price sync for this bottle
  // (feature #39). Null for wines that have never been synced — the UI
  // falls back to the most recent WineValuation.date in that case.
  lastValuationSyncAt DateTime?           @map("last_valuation_sync_at")
  member           Member                @relation(fields: [memberId], references: [id], onDelete: Restrict)
  lockerSlots      LockerSlot[]
  certificates     ProvenanceCertificate[]
  valuations       WineValuation[]
  dispositions     WineDisposition[]

  @@index([memberId])
  @@index([memberId, region, varietal])
  @@index([memberId, status])
  @@index([memberId, status, currentValue(sort: Desc)])
  @@map("wines")
}

model WineValuation {
  id     String   @id @default(uuid())
  wineId String   @map("wine_id")
  source String
  price  Decimal  @db.Decimal(14, 2)
  date   DateTime
  wine   Wine     @relation(fields: [wineId], references: [id], onDelete: Cascade)

  @@unique([wineId, date, source])
  @@index([wineId, date(sort: Desc)])
  @@map("wine_valuations")
}

model Locker {
  id           String                @id @default(uuid())
  lockerNumber Int                   @map("locker_number")
  zone         String
  facilityId   String                @map("facility_id")
  memberId     String?               @map("member_id")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  facility     Facility              @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  member       Member?               @relation(fields: [memberId], references: [id], onDelete: SetNull)
  slots        LockerSlot[]
  readings     SensorReading[]
  alerts       Alert[]
  certificates ProvenanceCertificate[]

  @@unique([facilityId, lockerNumber])
  @@index([memberId])
  @@map("lockers")
}

model LockerSlot {
  id           String    @id @default(uuid())
  lockerId     String    @map("locker_id")
  slotPosition Int       @map("slot_position")
  wineId       String?   @map("wine_id")
  dateStored   DateTime? @map("date_stored")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  locker       Locker    @relation(fields: [lockerId], references: [id], onDelete: Cascade)
  wine         Wine?     @relation(fields: [wineId], references: [id], onDelete: SetNull)

  @@unique([lockerId, slotPosition])
  @@index([wineId])
  @@map("locker_slots")
}

model SensorReading {
  id          Int      @id @default(autoincrement())
  lockerId    String   @map("locker_id")
  temperature Decimal  @db.Decimal(5, 2)
  humidity    Decimal  @db.Decimal(5, 2)
  vibration   Decimal  @db.Decimal(5, 3)
  lightLux    Decimal  @map("light_lux") @db.Decimal(5, 2)
  timestamp   DateTime @default(now())
  locker      Locker   @relation(fields: [lockerId], references: [id], onDelete: Cascade)

  @@index([lockerId, timestamp(sort: Desc)])
  @@map("sensor_readings")
}

model Alert {
  id         String    @id @default(uuid())
  lockerId   String    @map("locker_id")
  type       AlertType
  severity   Severity
  message    String
  timestamp  DateTime  @default(now())
  resolved   Boolean   @default(false)
  notifiedAt DateTime? @map("notified_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  locker     Locker    @relation(fields: [lockerId], references: [id], onDelete: Cascade)

  @@index([lockerId, timestamp(sort: Desc)])
  @@index([resolved, lockerId, timestamp(sort: Desc)])
  // [lockerId, type, resolved, notifiedAt] is a strict superset of the
  // older [lockerId, type, notifiedAt] index; Postgres can satisfy both
  // query shapes from the 4-column B-tree without needing the shorter one.
  @@index([lockerId, type, resolved, notifiedAt(sort: Desc)])
  @@map("alerts")
}

model ProvenanceCertificate {
  id                String   @id @default(uuid())
  wineId            String   @map("wine_id")
  lockerId          String   @map("locker_id")
  monitoringStart   DateTime @map("monitoring_start")
  monitoringEnd     DateTime @map("monitoring_end")
  tempMean          Decimal? @map("temp_mean") @db.Decimal(5, 2)
  tempMin           Decimal? @map("temp_min") @db.Decimal(5, 2)
  tempMax           Decimal? @map("temp_max") @db.Decimal(5, 2)
  humidityMean      Decimal? @map("humidity_mean") @db.Decimal(5, 2)
  dataIntegrityHash String   @map("data_integrity_hash")
  certificateNumber String   @unique @map("certificate_number")
  createdAt         DateTime @default(now()) @map("created_at")
  wine              Wine     @relation(fields: [wineId], references: [id], onDelete: Cascade)
  locker            Locker   @relation(fields: [lockerId], references: [id], onDelete: Cascade)

  @@index([wineId, lockerId])
  @@map("provenance_certificates")
}

model WineDisposition {
  id        String          @id @default(uuid())
  wineId    String          @map("wine_id")
  memberId  String          @map("member_id")
  type      DispositionType
  date      DateTime
  salePrice Decimal?        @map("sale_price") @db.Decimal(14, 2)
  recipient String?
  notes     String?
  createdAt DateTime        @default(now()) @map("created_at")
  wine      Wine            @relation(fields: [wineId], references: [id], onDelete: Restrict)
  member    Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([wineId, type, date])
  @@index([wineId])
  @@index([memberId])
  @@map("wine_dispositions")
}
